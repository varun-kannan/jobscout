{
  "name": "jobscout",
  "version": "0.1.0",
  "description": "Search twenty job engines at once, ranked by how many of your actual skills each role asks for.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "jobscout": "./dist/jobscout"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --outfile dist/jobscout",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "citty": "^0.1.6",
    "clipboardy": "^5.3.2",
    "ink": "^7.1.1",
    "mammoth": "^1.12.1",
    "picocolors": "^1.1.1",
    "react": "^19.2.8",
    "smol-toml": "^1.4.2",
    "unpdf": "^1.8.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "ink-testing-library": "^4.0.0",
    "react-devtools-core": "^7.0.1",
    "typescript": "^5.9.3"
  }
}
